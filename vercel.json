{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/brevo/smtp/email.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 15
    },
    "api/brevo/contacts.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/brevo/smtp/email",
      "destination": "/api/brevo/smtp/email"
    },
    {
      "source": "/api/brevo/contacts",
      "destination": "/api/brevo/contacts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
